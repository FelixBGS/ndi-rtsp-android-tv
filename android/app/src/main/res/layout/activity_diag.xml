<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingLeft="@dimen/settings_side_padding"
        android:paddingTop="40dp"
        android:paddingRight="@dimen/settings_side_padding"
        android:paddingBottom="40dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/diag_title"
            android:textColor="@color/text"
            android:textSize="30sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/diag_subtitle"
            android:textColor="@color/text_secondary"
            android:textSize="16sp" />

        <TextView
            style="@style/SettingsLabel"
            android:text="@string/diag_host" />

        <EditText
            android:id="@+id/host_input"
            style="@style/SettingsInput"
            android:hint="@string/diag_host_hint"
            android:imeOptions="actionDone"
            android:inputType="textUri|textNoSuggestions" />

        <Button
            android:id="@+id/run"
            style="@style/SettingsButton.Primary"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_weight="0"
            android:text="@string/diag_run" />

        <TextView
            android:id="@+id/result"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="@drawable/input_bg"
            android:fontFamily="monospace"
            android:padding="16dp"
            android:textColor="@color/text"
            android:textIsSelectable="true"
            android:textSize="15sp" />
    </LinearLayout>
</ScrollView>
